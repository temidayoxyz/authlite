{
  "name": "@xyzintel/authlite-core",
  "version": "0.1.3",
  "description": "Core authentication engine for AuthLite. Secure, lightweight, and database-agnostic.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "test": "vitest"
  },
  "keywords": [
    "auth",
    "authentication",
    "sqlite",
    "argon2",
    "sessions",
    "lightweight"
  ],
  "author": "xyzintel",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
