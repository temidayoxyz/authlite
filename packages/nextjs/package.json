{
  "name": "@xyzintel/authlite-nextjs",
  "version": "0.1.3",
  "description": "Next.js integration for AuthLite. Supports Server Components and Server Actions.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts"
  },
  "keywords": [
    "auth",
    "nextjs",
    "authlite",
    "react",
    "server-components",
    "server-actions"
  ],
  "author": "xyzintel",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@xyzintel/authlite-core": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  }
}
